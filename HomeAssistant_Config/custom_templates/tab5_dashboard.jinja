      ('reveil_jours_repos', 'bascule', 'Sonner aussi les jours de repos', 'Ring on days off too', 'mdi:calendar-remove', 12)] %}
{%- if genre == 'titre' %}
          - type: heading
            heading: "{{ t(fr_, en_) }}"
            heading_style: subtitle
{%- elif T[cle] %}
          - type: tile
            entity: {{ T[cle] }}
            name: "{{ t(fr_, en_) }}"
            icon: {{ icone }}
{%- if genre in ['liste', 'bascule', 'boutons'] %}
            features_position: inline
{%- endif %}
{%- if genre == 'liste' %}
            features:
              - type: select-options
                style: dropdown
{%- elif genre == 'bascule' %}
            features:
              - type: toggle
{%- elif genre in ['curseur', 'boutons'] %}
            features:
              - type: numeric-input
                style: {{ 'slider' if genre == 'curseur' else 'buttons' }}
{%- endif %}
            grid_options:
              columns: {{ largeur }}
{%- endif %}
{%- endfor %}
{%- endif %}

  # ─── Sous-vue Santé : quand quelque chose cloche ───
  - title: "{{ t('Santé Tab5', 'Tab5 health') }}"
    path: tab5-sante
    icon: mdi:heart-pulse
    type: sections
    max_columns: 4
    subview: true
    back_path: /{{ adresse }}/tab5
    sections:
      - type: grid
        cards:
          - type: heading
            heading: "{{ t('Quand quelque chose cloche', 'When something is wrong') }}"
            icon: mdi:stethoscope
          - type: markdown
            text_only: true
            content: |-
              - **{{ t('Écran figé, données anciennes', 'Frozen screen, old data') }}**{{ t(" : « Push HA actif » doit être allumé, sinon Home Assistant n'envoie plus rien à l'écran ; puis « MAJ écran ».", ': « HA push on » must be on, otherwise Home Assistant sends nothing to the screen; then « Refresh screen ».') }} [{{ t('Cas déjà vu', 'Known case') }}]({{ doc('troubleshooting.md', 'météo--planning--clim-absents-alors-que-lappareil-est-en-ligne', 'weather--planning--climate-data-missing-but-the-device-is-online') }})
              - **{{ t('Tablette déconnectée', 'Tablet disconnected') }}**{{ t(" : alimentation et Wi-Fi. Écran noir et tablette absente du réseau après une mise à jour : une vraie coupure (appui long, USB débranché 15 s).", ': power and Wi-Fi. Black screen and tablet off the network after an update: a real power cut (long press, USB unplugged for 15 s).') }} [{{ t('Détail', 'Details') }}]({{ doc('troubleshooting.md', 'écran-noir--appareil-absent-du-réseau-après-une-ota--le-co-processeur-wifi-nest-pas-remonté', 'black-screen--device-off-the-network-after-an-ota--the-wi-fi-co-processor-never-came-up') }})
              - **{{ t('Redémarrages', 'Restarts') }}**{{ t(' : « Raison du dernier démarrage » ci-dessous ; un redémarrage inattendu et le journal envoyé par la tablette arrivent en notification.', ': « Last start reason » below; an unexpected restart and the log sent by the tablet arrive as notifications.') }}
              - **{{ t('Fichiers HA en retard', 'HA files out of date') }}**{{ t(" : remplacez-les par ceux de l'archive tab5_home_assistant.zip de la même version que la tablette.", ': replace them with those of the tab5_home_assistant.zip archive of the same version as the tablet.') }}
              - **{{ t("Une zone manque à l'écran", 'A zone is missing on screen') }}**{{ t(' : « Zones masquées », vue Réglages.', ': « Hidden zones », Settings view.') }}
          - type: shortcut
            label: "{{ t('Page de la tablette', 'Tablet page') }}"
            description: "{{ t('Capteurs et diagnostic', 'Sensors and diagnostics') }}"
            icon: mdi:tablet-cellphone
            tap_action:
              action: navigate
              navigation_path: /config/devices/device/{{ device_id(ns.api) }}
            grid_options:
              columns: 12
          - type: shortcut
            label: "{{ t('Journal de HA', 'HA logs') }}"
            description: "{{ t('Erreurs et avertissements', 'Errors and warnings') }}"
            icon: mdi:math-log
            tap_action:
              action: navigate
              navigation_path: /config/logs
            grid_options:
              columns: 6
          - type: shortcut
            label: "{{ t('Réparations', 'Repairs') }}"
            description: "{{ t('Ce que HA signale', 'What HA reports') }}"
            icon: mdi:wrench-outline
            tap_action:
              action: navigate
              navigation_path: /config/repairs
            grid_options:
              columns: 6
          - type: shortcut
            label: "{{ t('Dépannage', 'Troubleshooting') }}"
            description: "{{ t('Pannes déjà diagnostiquées', 'Incidents already diagnosed') }}"
            icon: mdi:book-open-variant
            tap_action:
              action: url
              url_path: {{ doc('troubleshooting.md', 'version-française', '') }}
            grid_options:
              columns: 12
          - type: heading
            heading: "{{ t('En bref', 'At a glance') }}"
            icon: mdi:clipboard-pulse-outline
          - type: markdown
            content: |-
              | {{ t('Point', 'Item') }} | {{ t('État', 'Status') }} |
              |:--|:--|
              | {{ t('Liaison avec HA', 'Link with HA') }} | {{ allume(T.api, t('connectée', 'connected'), t('coupée', 'lost')) }} |
{%- if 'input_boolean.is_primary_active' in present %}
              | {{ t('Push HA', 'HA push') }} | {{ allume('input_boolean.is_primary_active', t('actif', 'on'), t('coupé : l’écran ne reçoit plus rien', 'off: the screen gets nothing')) }} |
{%- endif %}
{%- if T.uptime %}
              | {{ t('Démarrée le', 'Started on') }} | {% raw %}{% set d = as_timestamp(states('{% endraw %}{{ T.uptime }}{% raw %}'), none) %}{{ d | timestamp_custom('%d/%m %H:%M') if d else '—' }}{% endraw %} |
{%- endif %}
{%- if T.raison %}
              | {{ t('Raison du démarrage', 'Start reason') }} | {% raw %}{{ states('{% endraw %}{{ T.raison }}{% raw %}') }}{% endraw %} |
{%- endif %}
{%- if T.firmware %}
              | Firmware | {% raw %}{{ state_attr('{% endraw %}{{ T.firmware }}{% raw %}', 'installed_version') }}{{ (' · <font color="#ff9800">' ~ state_attr('{% endraw %}{{ T.firmware }}{% raw %}', 'latest_version') ~ ' {% endraw %}{{ t('disponible', 'available') }}{% raw %}</font>') if is_state('{% endraw %}{{ T.firmware }}{% raw %}', 'on') else '' }}{% endraw %} |
{%- endif %}
{%- if 'sensor.tab5_version_des_fichiers_ha' in present %}
              | {{ t('Fichiers HA', 'HA files') }} | {% raw %}{{ states('sensor.tab5_version_des_fichiers_ha') }}{% endraw %}
{%- if 'binary_sensor.tab5_fichiers_ha_en_retard' in present %}{% raw %}{{ ' · <font color="#ff9800">{% endraw %}{{ t('en retard', 'out of date') }}{% raw %}</font>' if is_state('binary_sensor.tab5_fichiers_ha_en_retard', 'on') else '' }}{% endraw %}{%- endif %} |
{%- endif %}
{%- if 'sensor.tab5_unavailable_count' in present %}
              | {{ t('Entités HA indisponibles', 'Unavailable HA entities') }} | {% raw %}{{ states('sensor.tab5_unavailable_count') }}{% endraw %} |
{%- endif %}
{%- if T.wifi %}
              | {{ t('Signal Wi-Fi', 'Wi-Fi signal') }} | {% raw %}{{ states('{% endraw %}{{ T.wifi }}{% raw %}') }}{% endraw %} dBm |
{%- endif %}
{#- Gardes de santé présentes ; « coupées » = interrupteur sur off (normal pendant une OTA). #}
{%- set gardes = [A.tab5_health_api_off_2min, A.tab5_health_primary_off_5min, A.tab5_health_unexpected_reboot,
                  A.tab5_health_template_error, A.tab5_health_fichiers_ha, A.tab5_health_journal] | select | list %}
{%- if gardes %}
              | {{ t('Alertes de santé', 'Health alerts') }} | {% raw %}{% set n = {% endraw %}{{ gardes }}{% raw %} | select('is_state', 'off') | list | count %}{{ '{% endraw %}{{ t('toutes actives', 'all on') }}{% raw %}' if n == 0 else '<font color="#ff9800">' ~ n ~ ' {% endraw %}{{ t('coupée(s)', 'off') }}{% raw %}</font>' }}{% endraw %} |
{%- endif %}
      - type: grid
        cards:
          - type: heading
            heading: "{{ t('État', 'Status') }}"
            icon: mdi:heart-pulse
          - type: markdown
            text_only: true
            content: |-
              {{ t("« Raison du dernier démarrage » dit si c'était une mise à jour, une coupure ou un plantage. « Fichiers HA » vaut « dépôt » pour des fichiers pris dans le dépôt plutôt que dans une archive de version. « Entités HA indispo » compte toute la maison, pas seulement la tablette.", '« Last start reason » tells an update, a power cut or a crash apart. « HA files » reads « dépôt » for files taken from the repository rather than from a release archive. « Unavailable HA entities » counts the whole home, not only the tablet.') }}
{%- for ent, fr_, en_, icone, largeur in [
