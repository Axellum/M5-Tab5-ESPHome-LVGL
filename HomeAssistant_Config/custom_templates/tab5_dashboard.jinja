                                 (T.temperature, 'Température du processeur', 'Processor temperature', 'mdi:thermometer'),
                                 (T.pile, 'Pile libre (minimum)', 'Free stack (minimum)', 'mdi:layers-outline')] %}
{%- if ent %}
