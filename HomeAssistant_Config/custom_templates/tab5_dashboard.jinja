      ('binary_sensor.tab5_fichiers_ha_en_retard' if 'binary_sensor.tab5_fichiers_ha_en_retard' in present else '', 'En retard ?', 'Out of date?', 'mdi:file-alert', 6),
      (T.c6, 'Puce Wi-Fi (C6)', 'Wi-Fi chip (C6)', 'mdi:chip', 6),
      ('sensor.tab5_unavailable_count' if 'sensor.tab5_unavailable_count' in present else '', 'Entités HA indispo', 'Unavailable HA entities', 'mdi:alert-circle-outline', 6)] %}
