# Gitignore settings for ESPHome
# This is an example and may include too much for your use-case.
# You can modify this file to suit your needs.
/.esphome/
secrets.yaml
Tab5/user_entities.yaml

# Bytecode Python (composants ESPHome custom)
__pycache__/
*.pyc

# Ignorer les scripts de l'IA et tests locaux
/ia_tools_scripts/
/archives/
config_out.txt
test_*.yaml

# Logs
*.log
home-assistant_*.log

# Configurations et logs locaux ESPHome
config_dump.yaml
esphome_live_logs.txt

# Anciennes copies privees de la config HA, OBSOLETES depuis le 26/09/2026 (lot 3 de
# l'audit « ouverture ») : la production tourne sur packages/tab5_push.yaml et
# packages/volet_serre_tracking.yaml rendus. Gardees ignorees pour qu'une copie
# locale restante ne soit jamais commitee.
HomeAssistant_Config/automations_tab5.yaml
HomeAssistant_Config/scripts_tab5.yaml
HomeAssistant_Config/template_sensors_meteo_tab5.yaml

# Audio TTS experimental, anterieur au pipeline Voice HA — inutilise par le firmware
Tab5/tts_library/
Tab5/tts_library_v2/

# Cache TTS Piper local (HA / moteur) — pas utilise par le firmware
audio_lib/

# Garde-fou : lien symbolique recursif Tab5/Tab5 -> Tab5 cree par accident.
# Supprime le 30/07/2026 ; la regle reste pour que la recidive ne soit jamais
# versionnee. (NB 06/09/2026 : E: n'a jamais ete une jonction vers H:, c'est un
# volume distinct — la racine unique du workspace est H:\AuxFilsDesIdees.)
Tab5/Tab5/

# Identifiants HA reels (placeholder -> valeur) et rendu deployable produit par
# tools/render_ha_config.py. Les fichiers publics ne contiennent que des
# placeholders ; modele suivi : HomeAssistant_Config/placeholders.example.yaml
HomeAssistant_Config/placeholders.yaml
HomeAssistant_Config/rendered/


# Dossier de travail de l'IDE Qoder, posé dans chaque dépôt ouvert. Le moteur
# le ramassait dans le diff de ses tâches autonomes : la porte d'arborescence
# refusait le livrable (9 tâches sur 14 abandonnées le 24/08).
.qoder/
